{
  "name": "@thisismissem/adonisjs-atproto-xrpc",
  "description": "Adonis.js provider for building an AT Protocol XRPC service",
  "version": "0.0.0",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.4+sha512.1c67b3b359b2d408119ba1ed289f34b8fc3c6873412bec6fd264fbdc82489e510fcbecb9ce9d22dae7f3b76269d8441046014bdca53b9979cd7a561ad631b800",
  "type": "module",
  "files": [
    "build",
    "!build/bin",
    "!build/tests"
  ],
  "main": "build/index.js",
  "exports": {
    ".": "./build/index.js",
    "./provider": "./build/providers/provider.js",
    "./services/xrpc": "./build/services/xrpc.js",
    "./types": "./build/src/types.js",
    "./factories/xrpc": "./build/factories/xrpc.js",
    "./errors": "./build/src/errors.js"
  },
  "scripts": {
    "changeset": "changeset",
    "copy:templates": "copyfiles \"stubs/**/*.stub\" build",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm run typecheck && eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:write": "prettier --write",
    "quick:test": "node --import=@poppinss/ts-exec --enable-source-maps bin/test.ts",
    "pretest": "pnpm run lint",
    "test": "c8 pnpm run quick:test",
    "types:check": "attw --pack . --profile esm-only --profile node16 --ignore-rules=cjs-resolves-to-esm",
    "precompile": "pnpm run lint",
    "compile": "tsdown && tsc --emitDeclarationOnly --declaration",
    "postcompile": "pnpm run copy:templates",
    "build": "pnpm run compile",
    "version-packages": "changeset version && pnpm run format:write CHANGELOG.md && git add package.json CHANGELOG.md",
    "release": "pnpm run build && changeset publish",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "adonisjs",
    "adonis",
    "atproto",
    "at protocol",
    "xrpc"
  ],
  "author": "Emelia Smith",
  "license": "MIT",
  "contributors": [
    {
      "name": "Emelia Smith",
      "url": "https://github.com/thisismissem"
    }
  ],
  "repository": {
    "url": "https://github.com/ThisIsMissEm/adonisjs-atproto-xrpc"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.0.0",
    "@adonisjs/core": "^7.0.1",
    "@adonisjs/eslint-config": "3.0.0",
    "@adonisjs/lucid": "^22.4.0",
    "@adonisjs/prettier-config": "^1.4.5",
    "@adonisjs/tsconfig": "^2.0.0",
    "@arethetypeswrong/cli": "^0.18.2",
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.30.0",
    "@japa/assert": "^4.2.0",
    "@japa/file-system": "^3.0.0",
    "@japa/runner": "^5.3.0",
    "@poppinss/ts-exec": "^1.4.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.3.5",
    "@types/ws": "^8.18.1",
    "better-sqlite3": "^12.9.0",
    "c8": "^11.0.0",
    "copyfiles": "^2.4.1",
    "eslint": "^10.0.3",
    "light-my-request": "^6.6.0",
    "prettier": "^3.8.1",
    "tsdown": "^0.21.0",
    "typescript": "^5.4.5",
    "yalc": "1.0.0-pre.53"
  },
  "peerDependencies": {
    "@adonisjs/assembler": "^8.0.0",
    "@adonisjs/core": "^7.0.1"
  },
  "peerDependenciesMeta": {
    "@adonisjs/assembler": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "tsdown": {
    "entry": [
      "./index.ts",
      "./configure.ts",
      "./providers/provider.ts",
      "./services/xrpc.ts",
      "./src/types.ts",
      "./src/router/index.ts",
      "./src/router/types.ts",
      "./src/router/route.ts",
      "./src/router/group.ts",
      "./src/serializer.ts",
      "./src/context.ts",
      "./src/response.ts",
      "./src/stream.ts",
      "./src/exception_handler.ts",
      "./src/errors.ts",
      "./src/utils.ts",
      "./factories/xrpc.ts"
    ],
    "outDir": "./build",
    "clean": true,
    "format": "esm",
    "minify": "dce-only",
    "fixedExtension": false,
    "dts": false,
    "treeshake": false,
    "sourcemaps": false,
    "target": "esnext",
    "unbundle": true
  },
  "c8": {
    "reporter": [
      "text",
      "html"
    ],
    "exclude": [
      "tests/**"
    ]
  },
  "prettier": "@adonisjs/prettier-config",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  },
  "dependencies": {
    "@atcute/cbor": "^2.3.3",
    "@atcute/lexicons": "^2.0.0",
    "@atcute/xrpc-server": "^2.0.0",
    "@atcute/xrpc-server-node": "^2.0.0",
    "@poppinss/exception": "^1.2.3",
    "@poppinss/macroable": "^1.1.2",
    "light-my-websocket": "^0.0.3",
    "ws": "^8.21.0"
  }
}
